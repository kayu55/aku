#!/bin/bash
# /usr/bin/cek-ssh - ala babi gawe SSH WS
y='\033[1;33m'; UK="\033[0;34m"; WHITE="\033[1;37m"; NC='\033[0m'
clear
systemctl reload ssh 2>/dev/null
if [ -e "/var/log/auth.log" ]; then LOG="/var/log/auth.log"; else LOG="/var/log/secure"; fi

echo -e "${UK}┌──────────────────────────────────────────┐${NC}"
echo -e "  ${WHITE}        SSH WS USER LOGIN (ala BABI) ${NC}"
echo -e "${UK}└──────────────────────────────────────────┘${NC}"

# Ambil PID Dropbear + OpenSSH seng isih urip
data=( $(ps aux | grep -i dropbear | grep -v grep | awk '{print $2}') $(ps aux | grep "\[priv\]" | grep -v grep | awk '{print $2}') )

for PID in "${data[@]}"; do
  # Cari neng auth.log gawe PID iki
  line=$(grep -E "dropbear\[$PID\]|sshd\[$PID\]" $LOG | grep -iE "Password auth succeeded|Accepted password for" | tail -n 1)
  [ -z "$line" ] && continue
  USER=$(echo $line | awk -F"for " '{print $2}' | awk '{print $1}')
  # IP neng auth.log pasti 127.0.0.1, abaikan
  # Ambil JAM login, contoh: Nov 20 02:15:30
  JAM=$(echo $line | awk '{print $3}' | cut -d: -f1,2) # 02:15
  JAM_FULL=$(echo $line | awk '{print $3}') # 02:15:30
  DETIK=$(echo $line | awk '{print $1, $2, $3}')

  # === CARI IP ASLI NENG NGINX LOG, jam e podo ± 1 menit ===
  # Nginx log format cf_real: IP_CF | IP_REMOTE - - [20/Nov/2026:02:15:30 ...
  IP_CF=$(grep "$JAM_FULL" /var/log/nginx/access.log 2>/dev/null | grep -E "/ssh|/ws|/proxy" | head -n 1 | cut -d'|' -f1 | tr -d ' ')
  # Fallback: cari neng ws-ssh.log (proxy.py seng wes di-log)
  if [ -z "$IP_CF" ] && [ -f "/var/log/ws-ssh.log" ]; then
    IP_CF=$(grep "$JAM" /var/log/ws-ssh.log 2>/dev/null | tail -n 1 | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" | head -n 1)
  fi
  # Fallback terakhir: cari IP terdekat neng nginx jam e podo
  if [ -z "$IP_CF" ]; then
    IP_CF=$(grep ":$JAM" /var/log/nginx/access.log 2>/dev/null | head -n 1 | cut -d'|' -f1 | tr -d ' ')
  fi

  echo -e "user : $USER"
  echo -e "  PID : $PID | Login : $DETIK"
  if [ "$IP_CF" != "" ] && [ "$IP_CF" != "127.0.0.1" ]; then
    echo -e "     1  [CF] $IP_CF"
    echo -e "     => 1 IP ketdeteksi (1 CF, 0 SNI)"
  else
    echo -e "     IP Cloudflare tok / 127.0.0.1 tok, log_format / proxy.py durung fix"
    echo -e "     [SSH] 127.0.0.1 (soko proxy.py)"
  fi
  echo ""
done

echo -e "${UK}└──────────────────────────────────────────┘${NC}"
echo ""
echo -e "\033[0;33m┌──────────────────────────────────────────┐\033[0m"
echo -e "      Autoscript By Arya Blitar - SSH ala BABI"
echo -e "\033[0;33m└──────────────────────────────────────────┘\033[0m"
echo ""
read -n 1 -s -r -p "Press any key to back on menu"
menu-ssh